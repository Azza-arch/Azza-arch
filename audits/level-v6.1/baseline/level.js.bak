  { id:'roof-e2', x:5128, y:824, width:250 },           // Zone E upper route (128px jump from roof-e1), ladder back down
  { id:'hill-plateau', x:6700, y:824, width:700 },      // Zone F/G gentle rise to the finish
  // "...gua" (cave) from the planning map: a genuinely optional side ledge,
